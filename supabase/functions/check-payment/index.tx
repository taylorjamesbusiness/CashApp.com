import "jsr:@supabase/functions-js/edge-runtime.d.ts";
import { serve } from "https://deno.land/std@0.224.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const SUPABASE_URL = Deno.env.get("SUPABASE_URL")!;
const SERVICE_KEY = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
const supabase = createClient(SUPABASE_URL, SERVICE_KEY);

const SOLANA_RPC = "https://api.mainnet-beta.solana.com";
const SOLANA_FALLBACK = "https://rpc.ankr.com/solana";

const TOKENS = {
  pyusd_solana: "2b1kV6DkPAnxd5ixfnxCpjxmKwqjjaYmCZfHsFu24GXo",
  usdc_solana: "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
};

const MY_WALLET = "Bk6HHmSVYwM3veHS9LpWq2TvGKjah9jmuBhCyrGu2TNa";
const DUST = 0.01;

const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "content-type, authorization",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

interface Body {
  invoice_id?: string;
  app?: string;
}

function json(body: unknown, status = 200): Response {
  return new Response(JSON.stringify(body), {
    status,
    headers: { ...CORS, "Content-Type": "application/json" },
  });
}

async function solanaRPC(body: object): Promise<any | null> {
  for (const rpc of [SOLANA_RPC, SOLANA_FALLBACK]) {
    try {
      const res = await fetch(rpc, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
        signal: AbortSignal.timeout(8000),
      });
      const data = await res.json();
      if (data?.result !== undefined) return data;
    } catch (_) {
      continue;
    }
  }
  return null;
}

async function getTokenBalance(wallet: string, mint: string): Promise<number> {
  const data = await solanaRPC({
    jsonrpc: "2.0",
    id: 1,
    method: "getTokenAccountsByOwner",
    params: [wallet, { mint }, { encoding: "jsonParsed" }],
  });

  const accounts = data?.result?.value ?? [];

  return accounts.reduce(
    (sum: number, acc: any) =>
      sum + Number(acc?.account?.data?.parsed?.info?.tokenAmount?.uiAmount ?? 0),
    0
  );
}

function resolveMint(app: string): string {
  if (app === "cashapp") return TOKENS.usdc_solana;
  return TOKENS.pyusd_solana;
}

serve(async (req: Request): Promise<Response> => {
  if (req.method === "OPTIONS") {
    return new Response(null, { headers: CORS });
  }

  if (req.method !== "POST") {
    return json({ error: "Method not allowed" }, 405);
  }

  try {
    const body = (await req.json().catch(() => ({}))) as Body;
    const invoiceId = body.invoice_id?.trim();
    const app = (body.app || "").toLowerCase().trim();

    if (!invoiceId) {
      return json({ error: "Missing invoice_id" }, 400);
    }

    if (!["paypal", "cashapp", "venmo"].includes(app)) {
      return json({ error: "Invalid app" }, 400);
    }

    const { data: payment, error: selErr } = await supabase
      .from("payments")
      .select("*")
      .eq("invoice_code", invoiceId)
      .eq("app", app)
      .maybeSingle();

    if (selErr) {
      console.error("[check-payment] select", selErr);
      return json({ error: selErr.message }, 500);
    }

    if (!payment) {
      return json({ error: "Invoice not found" }, 404);
    }

    if (payment.status === "paid") {
      return json({ success: true, status: "paid" });
    }

    const targetAmount = Number(payment.amount_usd || 0);
    const mint = payment.meta?.mint || resolveMint(app);

    const rawBefore = payment.meta?.balance_before;
    if (rawBefore === undefined || rawBefore === null) {
      console.log("[check-payment] balance_before missing → pending", { invoiceId, app });
      return json({ success: false, status: "pending" });
    }

    const balanceBefore = Number(rawBefore);
    const currentBalance = await getTokenBalance(MY_WALLET, mint);
    const delta = currentBalance - balanceBefore;

    console.log("[check-payment] delta check", {
      invoiceId,
      app,
      balanceBefore,
      currentBalance,
      delta,
      targetAmount,
    });

    if (delta < targetAmount - DUST) {
      return json({
        success: false,
        status: payment.status || "pending",
        delta: parseFloat(delta.toFixed(6)),
        needed: targetAmount,
      });
    }

    const { error: updErr } = await supabase
      .from("payments")
      .update({
        status: "paid",
        paid_at: new Date().toISOString(),
        meta: {
          ...(payment.meta || {}),
          balance_before: balanceBefore,
          balance_after: currentBalance,
          delta_received: parseFloat(delta.toFixed(6)),
          chain: "solana",
        },
      })
      .eq("invoice_code", invoiceId)
      .eq("app", app);

    if (updErr) {
      console.error("[check-payment] update", updErr);
      return json({ error: updErr.message }, 500);
    }

    return json({
      success: true,
      status: "paid",
      delta: parseFloat(delta.toFixed(6)),
      balance: currentBalance,
    });
  } catch (err) {
    console.error("[check-payment] unexpected", err);
    return json({ error: "Unexpected error" }, 500);
  }
});
